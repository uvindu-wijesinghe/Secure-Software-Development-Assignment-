# Server
PORT=8000
NODE_ENV=development

# MongoDB Atlas (replace placeholders; never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/library_management_system

# JWT signing secret - use a long random string in production
TOKEN_SECRET_KEY=change_me_to_a_long_random_secret

# Frontend origin
FRONTEND_URL=http://localhost:3000
